# --- Application ---
APP_NAME="AI Football Live Predictor"
LOG_LEVEL=INFO
DEBUG=false

# --- Database ---
# For SQLite (default): sqlite+aiosqlite:///./predictor.db
# For PostgreSQL:        postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./predictor.db

# --- Flashscore parser ---
FLASHSCORE_URL=https://www.flashscore.com/
HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=20000

# --- Live monitor ---
MONITOR_INTERVAL_SECONDS=30
MIN_MINUTE=50

# --- Signal thresholds ---
SIGNAL_THRESHOLD_WEAK=0.60
SIGNAL_THRESHOLD_MEDIUM=0.70
SIGNAL_THRESHOLD_STRONG=0.80

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
